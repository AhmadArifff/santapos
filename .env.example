# ==========================================
# SANTAPOS MONOREPO - ENVIRONMENT VARIABLES
# ==========================================

# -----------------
# 1. APPS/API (.env)
# -----------------
NODE_ENV=development
PORT=5000
DB_CLIENT=postgres
DB_SSL=false
DB_POOL_MAX=10

# Database URL (PostgreSQL local or Supabase Transaction Pooler)
# Local: postgresql://postgres:postgres@localhost:5432/santapos
# Supabase: postgresql://postgres.[REF]:[PASS]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/santapos

# Supabase API and Storage
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_STORAGE_BUCKET=restaurant-pos-assets
STORAGE_DRIVER=supabase
SUPABASE_SERVICE_ROLE_KEY=__YOUR_SERVICE_ROLE_KEY__

# JWT Authentication
JWT_SECRET=__RANDOM_STRONG_SECRET_AT_LEAST_32_CHARS__
JWT_EXPIRES=7d

# Cron secret for automated tasks
CRON_SECRET=__RANDOM_CRON_SECRET__

# AI Assistant (OpenRouter)
OPENROUTER_API_KEY=__YOUR_OPENROUTER_KEY__
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_SITE_NAME=Santapos AI Assistant
OPENROUTER_SITE_URL=http://localhost:3000

# CORS Allowed Origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------
# 2. APPS/WEB (.env.local)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_DOMAIN=santapos.id
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=__YOUR_ANON_KEY__
